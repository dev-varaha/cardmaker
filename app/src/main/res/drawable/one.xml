<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/item1"
        android:gravity="start">
        <shape
            android:dither="true"
            android:innerRadius="@dimen/size25dp"
            android:shape="ring" />
        <color android:color="@color/colorAccent" />
    </item>
    <item
        android:id="@+id/item2"
        android:gravity="center"
        android:left="10dp"
        android:top="10dp">
        <color android:color="@color/colorPrimary" />

    </item>
    <item
        android:id="@+id/item3"
        android:gravity="end"
        android:left="70dp"
        android:top="70dp">
        <color android:color="@color/colorAccent" />


    </item>
</layer-list>