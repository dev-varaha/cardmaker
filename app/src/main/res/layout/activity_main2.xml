<?xml version="1.0" encoding="utf-8"?>

<android.support.v4.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".Main2Activity">

        <ScrollView
            android:id="@+id/scrollutil"
            android:layout_width="@dimen/size50dp"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:background="@color/colorclan">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/size5dp"
                android:orientation="vertical"
                android:paddingBottom="@dimen/size10dp">

                <ImageView
                    android:id="@+id/iv_save"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size40dp"
                    android:layout_margin="@dimen/size1dp"
                    android:background="@drawable/rounded_background"

                    android:padding="@dimen/size5dp"
                    android:src="@drawable/ic_download" />

                <ImageView
                    android:id="@+id/iv_rotate"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size40dp"
                    android:layout_margin="@dimen/size1dp"
                    android:background="@drawable/rounded_background"
                    android:padding="@dimen/size5dp"
                    android:src="@drawable/ic_rotate" />

                <ImageView
                    android:id="@+id/iv_width"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size40dp"
                    android:layout_margin="@dimen/size1dp"
                    android:background="@drawable/rounded_background"
                    android:padding="@dimen/size5dp"

                    android:src="@drawable/ic_width" />

                <ImageView
                    android:id="@+id/iv_height"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size40dp"
                    android:layout_margin="@dimen/size1dp"

                    android:background="@drawable/rounded_background"
                    android:padding="@dimen/size5dp"
                    android:src="@drawable/ic_height" />

                <ImageView
                    android:id="@+id/iv_opacity"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size40dp"
                    android:layout_margin="@dimen/size1dp"

                    android:background="@drawable/rounded_background"
                    android:padding="@dimen/size5dp"
                    android:src="@drawable/ic_brightness" />


                <ImageView
                    android:id="@+id/iv_gellary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size40dp"
                    android:layout_margin="@dimen/size1dp"
                    android:background="@drawable/rounded_background"
                    android:padding="@dimen/size5dp"
                    android:src="@drawable/ic_gallery" />


                <ImageView
                    android:id="@+id/iv_colorpicker"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size40dp"

                    android:layout_margin="@dimen/size1dp"
                    android:background="@drawable/rounded_background"
                    android:padding="@dimen/size5dp"
                    android:src="@drawable/colorpicker" />

                <ImageView
                    android:id="@+id/iv_gradiantspicker"

                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size40dp"
                    android:layout_margin="@dimen/size1dp"
                    android:background="@drawable/rounded_background"
                    android:padding="@dimen/size5dp"
                    android:src="@drawable/ic_gradiantpicker" />

                <ImageView
                    android:id="@+id/iv_textsized"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size40dp"
                    android:layout_margin="@dimen/size1dp"
                    android:background="@drawable/rounded_background"
                    android:padding="@dimen/size5dp"
                    android:src="@drawable/ic_textsize" />

                <ImageView
                    android:id="@+id/iv_deleteview"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size40dp"
                    android:layout_margin="@dimen/size1dp"
                    android:background="@drawable/rounded_background"
                    android:padding="@dimen/size5dp"
                    android:src="@drawable/ic_deleteview" />

                <ImageView

                    android:id="@+id/iv_height_width"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size40dp"
                    android:layout_margin="@dimen/size1dp"
                    android:background="@drawable/rounded_background"
                    android:padding="@dimen/size5dp"
                    android:src="@drawable/ic_height_width" />


            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/ll_util1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/ll_util"
            android:layout_toLeftOf="@+id/scrollutil"
            android:background="@drawable/background">

            <android.support.v7.widget.CardView
                android:id="@+id/card_main"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/size5dp"
                app:cardBackgroundColor="@color/colorAccent">

                <ImageView
                    android:id="@+id/layerone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY" />

                <LinearLayout
                    android:id="@+id/iv_layerone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY">

                    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                        xmlns:app="http://schemas.android.com/apk/res-auto"
                        android:id="@+id/root"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false">


                    </RelativeLayout>

                </LinearLayout>


            </android.support.v7.widget.CardView>

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/ll_util"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginRight="@dimen/size50dp"
            android:background="@color/colorblacktrans"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_menu"
                android:layout_width="@dimen/size50dp"
                android:layout_height="@dimen/size50dp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:background="@drawable/ic_menu" />

            <android.support.v7.widget.RecyclerView
                android:id="@+id/recyclerview"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size50dp"
                android:layout_toLeftOf="@+id/iv_menu2"
                android:layout_toRightOf="@+id/iv_menu"
                android:background="@color/colorwhite" />

            <ImageView
                android:id="@+id/iv_menu2"
                android:layout_width="@dimen/size50dp"
                android:layout_height="@dimen/size50dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="@drawable/ic_menu2" />
        </RelativeLayout>


    </RelativeLayout>

    <android.support.design.widget.NavigationView
        android:id="@+id/nav_view1"
        android:layout_width="@dimen/size60dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true">

        <ListView
            android:id="@+id/list_navi1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorwhite"
            android:dividerHeight="@dimen/size1dp" />
    </android.support.design.widget.NavigationView>

    <android.support.design.widget.NavigationView
        android:id="@+id/nav_view2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorwhite"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/iv_backnav2"
                    android:layout_width="@dimen/size25dp"
                    android:layout_height="@dimen/size25dp"
                    android:layout_alignParentLeft="true"
                    android:background="@drawable/ic_backu" />


                <ImageView
                    android:id="@+id/iv_download"
                    android:layout_width="@dimen/size25dp"
                    android:layout_height="@dimen/size25dp"
                    android:layout_alignParentRight="true"
                    android:background="@drawable/ic_download" />

            </RelativeLayout>

            <FrameLayout
                android:id="@+id/container2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/colorblacktrans">

            </FrameLayout>
        </LinearLayout>
    </android.support.design.widget.NavigationView>
</android.support.v4.widget.DrawerLayout>