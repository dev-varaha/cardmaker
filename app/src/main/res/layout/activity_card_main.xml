<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    tools:context=".activities.CardMainActivity">

    <LinearLayout

        android:layout_width="@dimen/size90dp"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ListView
            android:id="@+id/listview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/size3dp"
            android:background="@color/colorwhite"
            android:dividerHeight="@dimen/size3dp"
            android:padding="@dimen/size1dp" />

    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <android.support.v7.widget.CardView
            android:id="@+id/card_root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/root_container"
            android:layout_margin="@dimen/size15dp">


        </android.support.v7.widget.CardView>

        <FrameLayout
            android:id="@+id/root_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size90dp"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"></FrameLayout>

    </RelativeLayout>


</LinearLayout>