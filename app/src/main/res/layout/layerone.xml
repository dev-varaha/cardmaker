<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/colorwhite"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/size5dp"
            android:gravity="center"
            android:text="@string/layeronedialodtext"
            android:textColor="@color/colorred" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/colorblacktrans"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_rounded"
                android:layout_width="@dimen/size80dp"
                android:layout_height="@dimen/size80dp"
                android:layout_margin="@dimen/size5dp"
                android:background="@drawable/ic_rect"
                android:padding="@dimen/size5dp" />

            <ImageView
                android:id="@+id/iv_roundedrect"
                android:layout_width="@dimen/size80dp"
                android:layout_height="@dimen/size80dp"
                android:layout_margin="@dimen/size5dp"
                android:background="@drawable/ic_rect_oval_corner"
                android:padding="@dimen/size5dp" />
        </LinearLayout>

    </LinearLayout>
</RelativeLayout>